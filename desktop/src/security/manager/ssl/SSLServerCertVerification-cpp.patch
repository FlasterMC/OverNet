+static bool IsTrustedRussianSiteCertificate(
+    const nsACString& aHostName, const nsCOMPtr<nsIX509Cert>& aCert) {
+  nsAutoCString host(aHostName);
+  ToLowerCase(host);
+  if (!StringEndsWith(host, ".ru"_ns) && !StringEndsWith(host, ".su"_ns) &&
+      !StringEndsWith(host, ".xn--p1ai"_ns)) {
+    return false;
+  }
+
+  nsAutoString fingerprint;
+  if (NS_FAILED(aCert->GetSha256Fingerprint(fingerprint))) {
+    return false;
+  }
+  NS_ConvertUTF16toUTF8 fingerprintUTF8(fingerprint);
+  bool listed = false;
+  {
+    auto certificates =
+        StaticPrefs::zen_russian_sites_trusted_certificates();
+    for (const nsACString& entry : certificates->Split(' ')) {
+      if (entry.Equals(fingerprintUTF8)) {
+        listed = true;
+        break;
+      }
+    }
+  }
+  if (!listed) {
+    return false;
+  }
+
+  nsCOMPtr<nsIX509CertValidity> validity;
+  PRTime notBefore;
+  PRTime notAfter;
+  if (NS_FAILED(aCert->GetValidity(getter_AddRefs(validity))) ||
+      NS_FAILED(validity->GetNotBefore(&notBefore)) ||
+      NS_FAILED(validity->GetNotAfter(&notAfter))) {
+    return false;
+  }
+  PRTime now = PR_Now();
+  if (now < notBefore || now > notAfter) {
+    return false;
+  }
+
+  nsTArray<uint8_t> certBytes;
+  if (NS_FAILED(aCert->GetRawDER(certBytes))) {
+    return false;
+  }
+  Input certInput;
+  Input hostInput;
+  if (certInput.Init(certBytes.Elements(), certBytes.Length()) != Success ||
+      hostInput.Init(BitwiseCast<const uint8_t*, const char*>(host.get()),
+                     host.Length()) != Success) {
+    return false;
+  }
+  return CheckCertHostname(certInput, hostInput) == Success;
+}
